{
  "name": "cronobr",
  "version": "2.0.0",
  "private": true,
  "main": "expo-router/entry",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.13.0 <23 || >=24.3.0 <25"
  },
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "jest --maxWorkers=2 --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "doctor": "npx expo-doctor@latest",
    "export:web": "expo export --platform web",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@expo/vector-icons": "15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.16",
    "expo-audio": "~58.0.11",
    "expo-constants": "~58.0.12",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.9",
    "expo-haptics": "~58.0.7",
    "expo-keep-awake": "~58.0.3",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.13",
    "expo-notifications": "~58.1.8",
    "expo-router": "~58.0.24",
    "expo-sharing": "~58.0.22",
    "expo-speech": "~58.0.3",
    "expo-splash-screen": "~58.0.10",
    "expo-sqlite": "~58.0.15",
    "expo-status-bar": "~58.0.3",
    "expo-system-ui": "~58.0.6",
    "expo-updates": "~58.0.21",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.1",
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "eslint": "9.39.5",
    "eslint-config-expo": "58.0.4",
    "eslint-plugin-security": "4.2.0",
    "jest": "30.5.2",
    "jest-expo": "58.0.11",
    "knip": "6.41.0",
    "lefthook": "2.2.2",
    "prettier": "3.9.10",
    "test-renderer": "1.3.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.71.2"
  },
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/legado/",
      "/e2e/"
    ],
    "collectCoverageFrom": [
      "src/domain/**/*.ts",
      "!src/domain/**/*.test.ts"
    ],
    "testTimeout": 20000,
    "setupFiles": [
      "<rootDir>/jest.setup.ts"
    ],
    "coverageThreshold": {
      "./src/domain/": {
        "branches": 100,
        "functions": 100,
        "lines": 100,
        "statements": 100
      }
    }
  }
}
